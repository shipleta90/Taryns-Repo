<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Keeps the agent running on the Mac mini and restarts it after reboots/crashes.
     Edit the two paths, then:  cp this-file ~/Library/LaunchAgents/ && launchctl load ~/Library/LaunchAgents/com.personal.agent.plist -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.personal.agent</string>
  <key>WorkingDirectory</key><string>/Users/YOU/Taryns-Repo/agent</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/YOU/Taryns-Repo/agent/.venv/bin/uvicorn</string>
    <string>app.main:build</string><string>--factory</string>
    <string>--host</string><string>127.0.0.1</string>
    <string>--port</string><string>8000</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/tmp/personal-agent.log</string>
  <key>StandardErrorPath</key><string>/tmp/personal-agent.log</string>
</dict>
</plist>
