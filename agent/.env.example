# Copy to .env and fill in. Never commit .env.

# Shared secret the web app sends as a Bearer token (defense in depth on top of Tailscale).
# Generate one:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
AGENT_TOKEN=

# Safety: while true, triage only LOGS what it would do. Flip to false after reviewing a dry run.
TRIAGE_DRY_RUN=true
# Circuit breaker: never trash more than this many messages in a single run.
TRIAGE_MAX_TRASH_PER_RUN=25
# Only look at mail from the last N hours (future-forward, no backlog cleanup).
TRIAGE_LOOKBACK_HOURS=24
# Nightly run time, 24h local time. Empty disables the scheduler.
TRIAGE_AT=02:30

# Where SQLite lives.
AGENT_DATA_DIR=./data

# Local model (Ollama). Run `ollama list` to see the exact name of the model you pulled.
OLLAMA_MODEL=llama3.1:8b
OLLAMA_URL=http://127.0.0.1:11434
# Morning briefing (off by default; the app no longer shows it). Time is 24h local.
BRIEFING_ENABLED=false
BRIEFING_AT=06:30
BRIEFING_MAX_ITEMS=25

# Chat assistant (hybrid): Claude handles chat; private content never leaves the Mini.
# Store your Anthropic API key in the Keychain with:  python -m app.secrets set-anthropic-key
TIMEZONE=America/Los_Angeles
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium

# Chief-of-Staff morning briefing (web research by Claude; no personal data is sent).
# Time is 24h local; leave empty to turn off. MORNING_ABOUT tailors "The Strategic Play".
MORNING_AT=06:30
MORNING_EFFORT=medium
MORNING_ABOUT=Independent operations consultant

# House budget: daily read-only bank sync via SimpleFIN (connect with: python -m app.secrets set-simplefin).
BUDGET_SYNC_AT=05:15
