# Copy to .env and fill in. Never commit .env.

# Shared secret the web app sends as a Bearer token (defense in depth on top of Tailscale).
# Generate one:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
AGENT_TOKEN=

# Safety: while true, triage only LOGS what it would do. Flip to false after reviewing a dry run.
TRIAGE_DRY_RUN=true
# Circuit breaker: never trash more than this many messages in a single run.
TRIAGE_MAX_TRASH_PER_RUN=25
# Only look at mail from the last N hours (future-forward, no backlog cleanup).
TRIAGE_LOOKBACK_HOURS=24
# Nightly run time, 24h local time. Empty disables the scheduler.
TRIAGE_AT=02:30

# Where SQLite lives.
AGENT_DATA_DIR=./data

# Local model (Ollama). Run `ollama list` to see the exact name of the model you pulled.
OLLAMA_MODEL=llama3.1:8b
OLLAMA_URL=http://127.0.0.1:11434
# Morning briefing (off by default; the app no longer shows it). Time is 24h local.
BRIEFING_ENABLED=false
BRIEFING_AT=06:30
BRIEFING_MAX_ITEMS=25

# Chat assistant (hybrid): Claude handles chat; private content never leaves the Mini.
# Store your Anthropic API key in the Keychain with:  python -m app.secrets set-anthropic-key
TIMEZONE=America/Los_Angeles
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium

# Chief-of-Staff morning briefing (web research by Claude; no personal data is sent).
# Time is 24h local; leave empty to turn off. MORNING_ABOUT tailors the briefing.
MORNING_AT=06:30
MORNING_EFFORT=medium
MORNING_ABOUT=Independent operations consultant
# Optional "Company & Industry Watch" section: the companies and industry to follow.
# e.g. MORNING_COMPANY_WATCH=Acme Corp and its main competitors, and the widget industry
MORNING_COMPANY_WATCH=

# House budget: daily read-only bank sync via SimpleFIN (connect with: python -m app.secrets set-simplefin).
BUDGET_SYNC_AT=05:15

# Your assistant. Emails are written as you and signed with OWNER_NAME.
OWNER_NAME=Taryn
ASSISTANT_NAME=Bruce
# How often (minutes) Bruce checks scheduling threads for replies. 0 turns it off.
FOLLOWUP_CHECK_MINUTES=10

# --- Cardona Family Hub (kitchen screen + phones, at /hub) -----------------------------------
# A SEPARATE token for the hub only. It can see the hub and check off tasks/groceries, nothing else.
# Generate one:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"   (must differ from AGENT_TOKEN)
HUB_TOKEN=
# Group words / nicknames in event titles -> who they mean. Separate with ;  join people with +
HUB_ALIASES=boys=Brooks+Elliott; kids=Brooks+Elliott+Pierce
# Events whose title contains any of these words show as "Private" on the hub (comma-separated).
HUB_HIDE=
# Calendars never shown on the hub (comma-separated names, e.g. a work calendar).
HUB_SKIP_CALENDARS=
# Todoist projects, in this order: family tasks, Cece's tasks, groceries, dinners.
TODOIST_PROJECTS=Family,Cece,Groceries,Dinners
# Store your Todoist token in the Keychain with:  python -m app.secrets set-todoist-token

# Bruce's 6:30 calendar check: suggests events to add/change/remove as cards in the Bruce tab.
CALENDAR_CHECK=true
FAMILY_CALENDAR=Family
